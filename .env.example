# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000

# Next.js / Frontend variables (React / Next.js prefix examples)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_ANALYTICS_ID=

# Backend configuration
BACKEND_PORT=3001


# Database Settings (NestJS / Node / Express backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engineering_db?schema=public

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_please_change_in_production
JWT_EXPIRATION=24h

# Logging level
LOG_LEVEL=info

OPENAI_API_KEY
